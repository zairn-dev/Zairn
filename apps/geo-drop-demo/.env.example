VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Drops are created and unlocked by the create-drop / unlock-drop Edge
# Functions (set GEODROP_ENCRYPTION_SECRET and CORS_ORIGIN on them). Never put
# the encryption secret in a VITE_ variable.
# IPFS: use server-side ipfs-proxy Edge Function instead of client-side pinning.
# Do NOT put IPFS API keys in VITE_ variables — they are bundled into the client build.
# Configure CORS_ORIGIN on the Edge Function to match the demo origin.
# VITE_IPFS_PROXY_URL=https://your-project.supabase.co/functions/v1/ipfs-proxy
